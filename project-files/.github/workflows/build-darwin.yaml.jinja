name: "darwin tests for '{{ project_slug }}'"
# This workflow is triggered on pushes to the repository.
on: [push]

# Superseded runs on the same ref are cancelled; tag refs are unique, so release
# runs are never affected.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true
env:
  DEVELOPER_DIR: /Applications/Xcode_15.4.app/Contents/Developer
  MACOSX_DEPLOYMENT_TARGET: 10.15

jobs:
  test-darwin:
    name: pytest on darwin
    runs-on: macos-14
    strategy:
      matrix:
        python_version: {{ python_versions | tojson }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: ./.github/actions/setup-uv-env
        with:
          python-version: {% raw %}${{ matrix.python_version }}{% endraw %}
      - name: Test with pytest
        run: make tests

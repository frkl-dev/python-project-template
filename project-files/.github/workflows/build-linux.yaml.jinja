name: "linux tests and package builds for '{{ project_slug }}'"
# This workflow is triggered on pushes to the repository.
on: [push]

# Superseded runs on the same ref are cancelled; tag refs are unique, so release
# runs are never affected.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:

  commitlint:
    name: lint commit message
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: wagoid/commitlint-github-action@v6

  test-linux:
    name: pytest on linux
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python_version: {{ python_versions | tojson }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: ./.github/actions/setup-uv-env
        with:
          python-version: {% raw %}${{ matrix.python_version }}{% endraw %}
      - name: test with pytest
        run: uv run pytest --cov-report=xml --cov={{ project_base_module }} tests

  type-check-linux:
    name: type check on linux
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python_version: {{ python_versions | tojson }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: ./.github/actions/setup-uv-env
        with:
          python-version: {% raw %}${{ matrix.python_version }}{% endraw %}
      - name: run type-checker
        run: make typecheck

  linting-linux:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: astral-sh/ruff-action@v3
        with:
          # Keep in sync with the ruff-pre-commit rev in .pre-commit-config.yaml,
          # otherwise CI and the hook disagree about what is clean (and "latest"
          # turns every new ruff release into a surprise CI failure).
          version: "0.16.3"
          args: "--version"
      - name: Run ruff check
        run: ruff check --no-fix .
      - name: Run ruff format check
        run: ruff format --check --diff .

  build_python_package:
    name: build python package
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: ./.github/actions/setup-uv-env
      - name: create packages
        run: uv run python -m build
      - name: upload artifacts
        uses: actions/upload-artifact@v6
        with:
          name: build-dists
          path: dist/

  release_python_package:
    name: publish python package to pypi
    {% raw %}if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags'){% endraw %}
    runs-on: ubuntu-latest
    needs:
      - test-linux
      - type-check-linux
      - linting-linux
      - build_python_package{% if anaconda_user %}
      - build_conda_package{% endif %}
    permissions:
      id-token: write
    # Trusted publishing is registered against this environment name (see TODO.md);
    # GitHub creates the environment on first use.
    environment: pypi
    steps:
      - name: Retrieve build distributions
        uses: actions/download-artifact@v7
        with:
          name: build-dists
          path: dist/
      - name: publish to PyPI  # make sure you have pypi trusted publishing configured for this repo: https://docs.pypi.org/trusted-publishers/
        uses: pypa/gh-action-pypi-publish@release/v1

{% if anaconda_user %}
  build_conda_package:
    name: build conda package
    runs-on: ubuntu-latest
    # The recipe packages the wheel from `build_python_package` rather than building
    # from source, so the conda package always contains exactly what goes to PyPI.
    needs:
      - build_python_package
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - name: retrieve build distributions
        uses: actions/download-artifact@v7
        with:
          name: build-dists
          path: dist/
      - name: derive package version from the wheel
        # `project_slug` never contains a dash, so field 2 is always the version.
        run: |
          version=$(basename dist/*.whl | cut -d- -f2)
          echo "PKG_VERSION=${version}" >> "$GITHUB_ENV"
      - name: build conda package
        uses: prefix-dev/rattler-build-action@v0.2.39
        with:
          recipe-path: conda.recipe/recipe.yaml
          artifact-name: conda-pkgs
          build-args: --channel conda-forge

  release_conda_package:
    name: publish conda package to anaconda
    {% raw %}if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags'){% endraw %}
    runs-on: ubuntu-latest
    needs:
      - test-linux
      - type-check-linux
      - linting-linux
      - build_python_package
      - build_conda_package
    steps:
      - name: check if ANACONDA_PUSH_TOKEN is set
        run: |
          if [ -z {% raw %}"${{ secrets.ANACONDA_PUSH_TOKEN }}"{% endraw %} ]; then
          echo "Error: ANACONDA_PUSH_TOKEN secret is not set"
          echo "Please configure the ANACONDA_PUSH_TOKEN secret in your repository settings"
          exit 1
          else
          echo "ANACONDA_PUSH_TOKEN is configured"
          fi
      - name: install rattler-build
        uses: prefix-dev/rattler-build-action@v0.2.39
        with:
          setup-only: true
      - name: retrieve conda packages
        uses: actions/download-artifact@v7
        with:
          name: conda-pkgs
          path: output/
      - name: release conda package
        # The key goes through the environment rather than `--api-key` so it never
        # shows up in a command line.
        env:
          ANACONDA_API_KEY: {% raw %}${{ secrets.ANACONDA_PUSH_TOKEN }}{% endraw %}
        run: |
          find output -type f \( -name '*.conda' -o -name '*.tar.bz2' \) \
            -exec rattler-build upload anaconda --owner {{ anaconda_user }} --channel main {} +

{% endif %}
  merge_tag_to_main:
    name: merge current tag to main branch
    runs-on: ubuntu-latest
    {% raw %}if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags'){% endraw %}
    permissions:
      contents: write
      actions: write
    needs:
      - release_python_package{% if anaconda_user %}
      - release_conda_package{% endif %}
    steps:
    - uses: actions/checkout@v6
      with:
        fetch-depth: 0
    - run: git config --global user.email "{{ email }}"
    - run: git config --global user.name "{{ full_name }}"
    - name: extract tag name
      run: {% raw %}echo "RELEASE_VERSION=${GITHUB_REF#refs/*/}" >> $GITHUB_ENV{% endraw %}
    - name: checkout main branch
      run: |
        if git show-ref --verify --quiet refs/heads/main; then
          git checkout main
        else
          git checkout -b main
        fi
    - name: merge tag
      run: git merge "${RELEASE_VERSION}"
    - name: push updated main branch
      # actions/checkout leaves its token-backed auth configured for `origin`, so no
      # token needs to appear on the command line.
      run: git push origin main
